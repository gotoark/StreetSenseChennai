{
  "name": "chennai-street-food-assistant",
  "version": "1.0.0",
  "description": "A Chennai street food recommendation system",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:frontend": "vite build",
    "dev": "ts-node src/index.ts",
    "dev:frontend": "vite",
    "server": "ts-node src/server.ts",
    "server:dev": "ts-node --watch src/server.ts",
    "start": "concurrently \"npm run server:dev\" \"npm run dev:frontend\"",
    "start:prod": "concurrently \"npm run server\" \"npm run dev:frontend\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "chennai",
    "street-food",
    "recommendations"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.2.1",
    "fast-check": "^3.15.0",
    "jest": "^29.5.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.1.4",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.0"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "cors": "^2.8.5",
    "express": "^4.18.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  }
}
